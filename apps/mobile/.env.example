# Base URL of the BarriApp backend API. Defaults to local dev if unset.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google OAuth client IDs for social sign-in (optional; leave empty to disable).
# Create them in Google Cloud Console → Credentials → OAuth client IDs.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Apple sign-in needs no client id here (native, iOS only).
