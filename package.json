{
  "name": "barriapp-client",
  "version": "0.1.0",
  "private": true,
  "description": "BarriApp client monorepo — Expo mobile/web app + Next.js admin panel",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "mobile": "pnpm --filter @barriapp/mobile start",
    "admin": "pnpm --filter @barriapp/admin dev",
    "api:generate": "pnpm --filter @barriapp/api-client generate",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@barriapp/config": "workspace:*",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "prettier": "^3.4.2",
    "semantic-release": "^24.2.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "eslint-plugin-react-hooks": "^5.1.0",
      "@xmldom/xmldom": "^0.8.13",
      "esbuild": "^0.25.0",
      "postcss": "^8.5.10",
      "tar": "^7.5.16",
      "vite": "^6.4.3",
      "uuid": "^11.1.1"
    }
  }
}
