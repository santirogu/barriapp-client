{
  "name": "@barriapp/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ${BARRIAPP_OPENAPI_URL:-http://localhost:8000/openapi.json} -o ./src/generated/schema.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@barriapp/shared": "workspace:*",
    "openapi-fetch": "^0.13.4"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.x",
    "react": ">=18",
    "zustand": "^5.x"
  },
  "devDependencies": {
    "@barriapp/config": "workspace:*",
    "@tanstack/react-query": "^5.62.11",
    "@types/react": "~18.3.12",
    "eslint": "^9.17.0",
    "openapi-typescript": "^7.5.0",
    "react": "18.3.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "zustand": "^5.0.2"
  }
}
